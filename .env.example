# ArenaPulse environment configuration.
#
# EVERY variable is OPTIONAL. With no .env at all, the app runs fully against
# deterministic mock twins and shows a "Demo mode (mock data)" badge. Add a
# key to switch that service to live — each one activates independently.
#
# Copy this file to `.env` and fill in what you have. Never commit real keys;
# `.env*` is gitignored.

# --- Gemini (Generative AI) — server-side only -----------------------------
# Google AI Studio API key. Absent => the assistant, recommendations, briefings,
# route narration, and tips are served by the deterministic mock twin.
GEMINI_API_KEY=

# Model id. Defaults to gemini-2.5-flash when unset.
GEMINI_MODEL=gemini-2.5-flash

# --- Google Maps (Transportation) — server-side only -----------------------
# Enables live Directions/Routes + Static Maps. Absent => mock journey plans and
# a locally generated SVG demo map. The key is proxied via /api/map-image and
# never reaches the browser.
GOOGLE_MAPS_API_KEY=

# --- Google Programmable Search (Grounded Live Info) — server-side only -----
# Both are required for live search; if either is absent, cited demo results are
# returned instead.
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_CX=

# --- Demo override ----------------------------------------------------------
# Set to "true" to force mock mode for ALL services even if keys are present.
MOCK_MODE=false
